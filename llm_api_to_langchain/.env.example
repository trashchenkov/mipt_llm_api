# Ноутбук выполняет реальные запросы и расходует квоту.
# Заполнить перед запуском. Ключ авторизации, НЕ временный access token.
# Ключ выдают в личном кабинете: https://developers.sber.ru/studio/workspaces/my-space/get/gigachat-api
# (проект GigaChat API → «Настройки API» → «Получить ключ»; ключ показывается один раз).
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Ultra
# Общая настройка учебного окружения.
GIGACHAT_VERIFY_SSL_CERTS=False

# Учебный прокси: только localhost, без отдельного ключа.
GPT2GIGA_MODE=DEV
GPT2GIGA_HOST=127.0.0.1
GPT2GIGA_PORT=8090
GPT2GIGA_ENABLE_API_KEY_AUTH=False
OPENAI_BASE_URL=http://127.0.0.1:8090/v1/
# Anthropic SDK сам добавляет /v1/messages — здесь без /v1/!
ANTHROPIC_BASE_URL=http://127.0.0.1:8090/
